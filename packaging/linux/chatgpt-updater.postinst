#!/bin/sh
set -eu

SERVICE_HELPER="/usr/lib/chatgpt/update-builder/packaging/linux/chatgpt-updater-user-service.sh"
if [ -f "$SERVICE_HELPER" ]; then
    # shellcheck source=/usr/lib/chatgpt/update-builder/packaging/linux/chatgpt-updater-user-service.sh
    . "$SERVICE_HELPER"
    if [ "${1:-}" = "configure" ] && [ -z "${2:-}" ]; then
        chatgpt_ensure_user_service_running || true
    else
        chatgpt_start_enabled_user_service || true
    fi
fi


exit 0
