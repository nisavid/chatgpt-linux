[Desktop Entry]
Name=ChatGPT
Comment=Unofficial community build. Not affiliated with, endorsed by, sponsored by, or supported by OpenAI.
# Workaround: desktop launches can inherit malformed Lmod BASH_FUNC_* exports
# left by Codex CLI shell snapshot replay. Bash imports those variables before
# the launcher starts and prints warnings. The real fix belongs in Codex CLI
# capture/replay: scrub stale BASH_FUNC_* values or recreate exported Bash
# functions consistently, then remove these targeted unsets.
Exec=env -u BASH_FUNC_ml%%%% -u BASH_FUNC_module%%%% BAMF_DESKTOP_FILE_HINT=/usr/share/applications/chatgpt.desktop CHROME_DESKTOP=chatgpt.desktop /usr/bin/chatgpt %u
Icon=chatgpt
X-ChatGPT-Linux-Managed=true
Terminal=false
Type=Application
Categories=Development;
MimeType=x-scheme-handler/codex;x-scheme-handler/codex-browser-sidebar;
Keywords=chatgpt;codex;openai;ai;coding;
StartupNotify=true
StartupWMClass=chatgpt
X-GNOME-WMClass=chatgpt
Actions=new-window;CheckForUpdates;InstallReadyUpdate;

[Desktop Action new-window]
Name=New Window
Exec=env -u BASH_FUNC_ml%%%% -u BASH_FUNC_module%%%% BAMF_DESKTOP_FILE_HINT=/usr/share/applications/chatgpt.desktop CHROME_DESKTOP=chatgpt.desktop CHATGPT_MULTI_LAUNCH=1 /usr/bin/chatgpt --new-instance

[Desktop Action CheckForUpdates]
Name=Check for Updates
Exec=/usr/bin/chatgpt-updater check-now

[Desktop Action InstallReadyUpdate]
Name=Install Ready Update
Exec=/usr/bin/chatgpt-updater install-ready
